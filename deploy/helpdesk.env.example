# Copy this file to helpdesk.env (same folder) and fill in real values.
# helpdesk.env holds secrets: it is git-ignored, never commit it.
# Format: KEY=value, no spaces around "=", no quotes.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# MySQL: use a dedicated user (see DEPLOY.md step 3), not root
DB_URL=jdbc:mysql://localhost:3306/helpdesk?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=helpdesk
DB_PASSWORD=put-a-strong-db-password-here

# Random, at least 32 characters. Generate one in PowerShell:
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
JWT_SECRET=paste-a-random-48-character-value-here
JWT_EXPIRATION_MINUTES=480

# The public address the app is served from
CORS_ALLOWED_ORIGINS=https://helpdesk.manageone.me
