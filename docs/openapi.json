{"openapi":"3.1.0","info":{"title":"Multi-Tenant Helpdesk API","description":"Ticketing API where every organization only sees its own users and tickets.\n\n1. Call `POST /api/auth/login` (demo users are listed in the README).\n2. Click **Authorize** and paste the `accessToken`.\n","version":"1.0.0"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"Email intake","description":"Called by the helpdesk mailbox script, authenticated by the organization's inbound key"},{"name":"Organization","description":"The caller's own organization"},{"name":"Auth","description":"Sign up an organization, log in, current user"},{"name":"Users","description":"Users of the caller's organization"},{"name":"Tickets","description":"Tickets of the caller's organization (customers: only their own)"},{"name":"Comments","description":"Replies and internal agent notes on a ticket"}],"paths":{"/api/tickets/{id}/status":{"put":{"tags":["Tickets"],"summary":"Change status, e.g. CLOSED to close (customers: close or reopen only)","operationId":"changeStatus","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeStatusRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TicketResponse"}}}}}}},"/api/tickets/{id}/requester":{"put":{"tags":["Tickets"],"summary":"Link the ticket to a customer, e.g. a mail from an unregistered address (admin, agent)","operationId":"linkRequester","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LinkRequesterRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TicketResponse"}}}}}}},"/api/tickets/{id}/assignee":{"put":{"tags":["Tickets"],"summary":"Assign to an agent, or unassign with assigneeId = null (admin, agent)","operationId":"assign","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AssignTicketRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TicketResponse"}}}}}}},"/api/users":{"get":{"tags":["Users"],"summary":"List users of my organization (admin, agent)","operationId":"list","parameters":[{"name":"role","in":"query","required":false,"schema":{"type":"string","enum":["ORG_ADMIN","AGENT","CUSTOMER"]}},{"name":"page","in":"query","description":"Zero-based page index (0..N)","required":false,"schema":{"type":"integer","default":0,"minimum":0}},{"name":"size","in":"query","description":"The size of the page to be returned","required":false,"schema":{"type":"integer","default":10,"minimum":1}},{"name":"sort","in":"query","description":"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.","required":false,"schema":{"type":"array","default":["fullName,ASC"],"items":{"type":"string"}}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageResponseUserResponse"}}}}}},"post":{"tags":["Users"],"summary":"Create an admin, agent or customer in my organization (admin)","operationId":"create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateUserRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}}}}},"/api/tickets":{"get":{"tags":["Tickets"],"summary":"Search and filter tickets with pagination","description":"Sort by createdAt, updatedAt, id or subject, e.g. sort=createdAt,desc","operationId":"search","parameters":[{"name":"status","in":"query","required":false,"schema":{"type":"string","enum":["OPEN","IN_PROGRESS","RESOLVED","CLOSED"]}},{"name":"priority","in":"query","required":false,"schema":{"type":"string","enum":["LOW","MEDIUM","HIGH","URGENT"]}},{"name":"assigneeId","in":"query","required":false,"schema":{"type":"integer","format":"int64"}},{"name":"unassigned","in":"query","description":"true = only tickets with no assignee","required":false,"schema":{"type":"boolean"}},{"name":"requesterId","in":"query","description":"Staff only; ignored for customers","required":false,"schema":{"type":"integer","format":"int64"}},{"name":"unlinked","in":"query","description":"Staff only: true = email tickets not linked to a customer yet","required":false,"schema":{"type":"boolean"}},{"name":"q","in":"query","description":"Text in the subject, or a ticket id","required":false,"schema":{"type":"string","maxLength":100,"minLength":0}},{"name":"page","in":"query","description":"Zero-based page index (0..N)","required":false,"schema":{"type":"integer","default":0,"minimum":0}},{"name":"size","in":"query","description":"The size of the page to be returned","required":false,"schema":{"type":"integer","default":10,"minimum":1}},{"name":"sort","in":"query","description":"Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.","required":false,"schema":{"type":"array","default":["createdAt,DESC"],"items":{"type":"string"}}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PageResponseTicketResponse"}}}}}},"post":{"tags":["Tickets"],"summary":"Raise a ticket. Staff may pass requesterId to raise it for a customer.","operationId":"create_1","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateTicketRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TicketResponse"}}}}}}},"/api/tickets/{ticketId}/comments":{"get":{"tags":["Comments"],"summary":"Comments on a ticket (customers never receive internal notes)","operationId":"list_1","parameters":[{"name":"ticketId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/CommentResponse"}}}}}}},"post":{"tags":["Comments"],"summary":"Add a reply, or an internal note with internal = true (admin, agent)","operationId":"add","parameters":[{"name":"ticketId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateCommentRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/CommentResponse"}}}}}}},"/api/organization/email-intake/rotate":{"post":{"tags":["Organization"],"summary":"Replace the inbound key; the old one stops working at once (admin)","operationId":"rotateInboundKey","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EmailIntakeResponse"}}}}}}},"/api/inbound/email":{"post":{"tags":["Email intake"],"summary":"Turn an inbound mail into a ticket, or a comment when its thread already has one","description":"201 = ticket created, 200 = comment added or duplicate message, 401 = bad key","operationId":"receive","parameters":[{"name":"X-Inbound-Key","in":"header","description":"The organization's inbound key (Email intake page)","required":false,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/InboundEmailRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/InboundEmailResult"}}}}},"security":[]}},"/api/auth/register-organization":{"post":{"tags":["Auth"],"summary":"Create a new organization and its first Org Admin; returns a token","operationId":"registerOrganization","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterOrganizationRequest"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthResponse"}}}}},"security":[]}},"/api/auth/login":{"post":{"tags":["Auth"],"summary":"Log in with email and password; returns a Bearer token","operationId":"login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AuthResponse"}}}}},"security":[]}},"/api/users/{id}":{"patch":{"tags":["Users"],"summary":"Rename, change role, activate or deactivate a user (admin)","operationId":"update","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateUserRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}}}}},"/api/tickets/{id}":{"get":{"tags":["Tickets"],"summary":"Ticket details","operationId":"get","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TicketResponse"}}}}}},"patch":{"tags":["Tickets"],"summary":"Edit subject, description or priority (customers: not priority)","operationId":"update_1","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateTicketRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TicketResponse"}}}}}}},"/api/users/agents":{"get":{"tags":["Users"],"summary":"Active agents of my organization, for assignment (admin, agent)","operationId":"agents","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/UserRef"}}}}}}}},"/api/tickets/{id}/history":{"get":{"tags":["Tickets"],"summary":"Status, assignment and edit history","operationId":"history","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/HistoryResponse"}}}}}}}},"/api/organization":{"get":{"tags":["Organization"],"summary":"My organization","operationId":"current","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/OrganizationResponse"}}}}}}},"/api/organization/email-intake":{"get":{"tags":["Organization"],"summary":"Inbound key and endpoint for the helpdesk mailbox script (admin)","operationId":"emailIntake","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EmailIntakeResponse"}}}}}}},"/api/auth/me":{"get":{"tags":["Auth"],"summary":"The logged-in user and their organization","operationId":"me","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/UserResponse"}}}}}}}},"components":{"schemas":{"ChangeStatusRequest":{"type":"object","properties":{"status":{"type":"string","enum":["OPEN","IN_PROGRESS","RESOLVED","CLOSED"]}},"required":["status"]},"TicketResponse":{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"subject":{"type":"string"},"description":{"type":"string"},"priority":{"type":"string","enum":["LOW","MEDIUM","HIGH","URGENT"]},"status":{"type":"string","enum":["OPEN","IN_PROGRESS","RESOLVED","CLOSED"]},"channel":{"type":"string","enum":["WEB","EMAIL"]},"requester":{"$ref":"#/components/schemas/UserRef"},"senderEmail":{"type":"string"},"senderName":{"type":"string"},"assignee":{"$ref":"#/components/schemas/UserRef"},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"},"resolvedAt":{"type":"string","format":"date-time"},"closedAt":{"type":"string","format":"date-time"}}},"UserRef":{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"fullName":{"type":"string"},"email":{"type":"string"},"role":{"type":"string","enum":["ORG_ADMIN","AGENT","CUSTOMER"]}}},"LinkRequesterRequest":{"type":"object","properties":{"requesterId":{"type":"integer","format":"int64"}},"required":["requesterId"]},"AssignTicketRequest":{"type":"object","properties":{"assigneeId":{"type":"integer","format":"int64"}}},"CreateUserRequest":{"type":"object","properties":{"fullName":{"type":"string","maxLength":120,"minLength":0},"email":{"type":"string","format":"email","maxLength":160,"minLength":0},"password":{"type":"string","maxLength":100,"minLength":8},"role":{"type":"string","enum":["ORG_ADMIN","AGENT","CUSTOMER"]}},"required":["email","fullName","password","role"]},"UserResponse":{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"fullName":{"type":"string"},"email":{"type":"string"},"role":{"type":"string","enum":["ORG_ADMIN","AGENT","CUSTOMER"]},"active":{"type":"boolean"},"organizationId":{"type":"integer","format":"int64"},"organizationName":{"type":"string"},"createdAt":{"type":"string","format":"date-time"}}},"CreateTicketRequest":{"type":"object","properties":{"subject":{"type":"string","maxLength":200,"minLength":0},"description":{"type":"string","maxLength":10000,"minLength":0},"priority":{"type":"string","enum":["LOW","MEDIUM","HIGH","URGENT"]},"requesterId":{"type":"integer","format":"int64"}},"required":["description","subject"]},"CreateCommentRequest":{"type":"object","properties":{"body":{"type":"string","maxLength":5000,"minLength":0},"internal":{"type":"boolean"}},"required":["body"]},"CommentResponse":{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"body":{"type":"string"},"internal":{"type":"boolean"},"author":{"$ref":"#/components/schemas/UserRef"},"externalAuthorName":{"type":"string"},"externalAuthorEmail":{"type":"string"},"viaEmail":{"type":"boolean"},"createdAt":{"type":"string","format":"date-time"}}},"EmailIntakeResponse":{"type":"object","properties":{"inboundKey":{"type":"string"},"endpointPath":{"type":"string"},"headerName":{"type":"string"}}},"InboundEmailRequest":{"type":"object","properties":{"threadId":{"type":"string","maxLength":200,"minLength":0},"messageId":{"type":"string","maxLength":250,"minLength":0},"fromEmail":{"type":"string","format":"email","maxLength":160,"minLength":0},"fromName":{"type":"string","maxLength":120,"minLength":0},"subject":{"type":"string","maxLength":2000,"minLength":0},"body":{"type":"string","maxLength":200000,"minLength":0}},"required":["fromEmail","threadId"]},"InboundEmailResult":{"type":"object","properties":{"outcome":{"type":"string","enum":["TICKET_CREATED","COMMENT_ADDED","DUPLICATE"]},"ticketId":{"type":"integer","format":"int64"},"linkedToCustomer":{"type":"boolean"}}},"RegisterOrganizationRequest":{"type":"object","properties":{"organizationName":{"type":"string","maxLength":120,"minLength":0},"adminName":{"type":"string","maxLength":120,"minLength":0},"email":{"type":"string","format":"email","maxLength":160,"minLength":0},"password":{"type":"string","maxLength":100,"minLength":8}},"required":["adminName","email","organizationName","password"]},"AuthResponse":{"type":"object","properties":{"accessToken":{"type":"string"},"tokenType":{"type":"string"},"expiresInSeconds":{"type":"integer","format":"int64"},"user":{"$ref":"#/components/schemas/UserResponse"}}},"LoginRequest":{"type":"object","properties":{"email":{"type":"string","format":"email","minLength":1},"password":{"type":"string","minLength":1}},"required":["email","password"]},"UpdateUserRequest":{"typ